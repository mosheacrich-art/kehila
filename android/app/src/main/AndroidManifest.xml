<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          Evita que Firebase Cloud Messaging se auto-inicialice al arrancar la app
          (antes incluso de que cargue el WebView/JS). Si en algún build falta o
          está mal configurado google-services.json, ese auto-init nativo lanza
          "FirebaseApp.getInstance() IllegalStateException" y tumba la app entera
          en el arranque — el try/catch de js/push.js no puede protegerlo porque
          ocurre en código nativo, antes de que corra ningún JS.
          Con esto, Firebase solo se inicializa cuando initNativePush() lo pide
          explícitamente desde home.html, ya protegido por try/catch.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Vibración para notificaciones -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera: profile photo and identity document upload during registration -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone: audio/video features and virtual rabbi consultations -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location: show nearby kosher restaurants and community services -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

</manifest>
